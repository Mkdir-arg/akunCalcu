        160,
        432
      ],
      "webhookId": "a2be1168-4816-4d09-ba40-8b648032d93d",
      "notes": "Responde 200 al instante (Meta reintenta si no recibe 200 rapido). Recibe mensajes entrantes Y estados de entrega (sent/delivered/read/failed) de TODO lo que manda el numero, incluida la agenda."
    },
    {
      "parameters": {
        "jsCode": "// Payload de la Cloud API de Meta: entry[].changes[].value.{metadata, contacts[], messages[], statuses[]}\n// Emite un item por mensaje entrante (tipo_evento 'mensaje') y uno por envio fallido (tipo_evento 'fallo_envio').\nconst miNumero = String($env.META_PHONE_NUMBER_ID || '');\nconst items = [];\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n  if (body.object !== 'whatsapp_business_account') continue;\n  for (const entry of (body.entry ?? [])) {\n    for (const change of (entry.changes ?? [])) {\n      const value = change.value ?? {};\n      const phoneId = String(value.metadata?.phone_number_id ?? '');\n      // Meta manda al mismo webhook los eventos del numero de prueba; solo nos interesa el real.\n      if (miNumero && phoneId && phoneId !== miNumero) continue;\n      const nombres = {};\n      for (const c of (value.contacts ?? [])) nombres[c.wa_id] = c.profile?.name ?? '';\n      for (const m of (value.messages ?? [])) {\n        const tipo = m.type ?? '';\n        const texto = tipo === 'text' ? (m.text?.body ?? '')\n          : tipo === 'button' ? (m.button?.text ?? '')\n          : tipo === 'interactive' ? (m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title ?? '')\n          : '';\n        const from = String(m.from ?? '');\n        items.push({ json: {\n          tipo_evento: 'mensaje',\n          numero_origen: from.replace(/[^0-9]/g, ''),\n          reply_jid: from,\n          push_name: nombres[from] ?? '',\n          texto,\n          is_audio: tipo === 'audio',\n          audio_id: m.audio?.id ?? '',\n          mime_type: m.audio?.mime_type ?? '',\n          message_id: m.id ?? '',\n          tipo_mensaje: tipo\n        } });\n      }\n      for (const s of (value.statuses ?? [])) {\n        if (s.status !== 'failed') continue;\n        items.push({ json: {\n          tipo_evento: 'fallo_envio',\n          message_id: s.id ?? '',\n          numero_destino: s.recipient_id ?? '',\n          timestamp: s.timestamp ?? '',\n          errores: (s.errors ?? []).map(e => ({ code: e.code, title: e.title, message: e.message, detalle: e.error_data?.details ?? '' }))\n        } });\n      }\n    }\n  }\n}\nreturn items;"
      },
