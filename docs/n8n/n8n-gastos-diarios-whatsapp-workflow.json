      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Sos un extractor de gastos en espanol rioplatense. Detecta CADA gasto que tenga un importe y devolvelo: descripcion y monto son OBLIGATORIOS, el tipo es OPCIONAL. Devolve SOLO JSON valido: un objeto con la clave gastos, que es un array de objetos con las claves descripcion (texto), monto (numero) y tipo (texto). Interpreta montos dichos en palabras: quince mil = 15000, dos mil quinientos = 2500. Capitaliza la descripcion. Valores validos de tipo: colocadores, colaboradores, fletes, retiros_propios, varios, proveedores, caja_chica; si lo dicen con otra palabra mapealo (flete a fletes, proveedor a proveedores, retiro o retiro propio a retiros_propios, caja a caja_chica). Si no hay un tipo claro, deja tipo en cadena vacia, pero NUNCA descartes el gasto por no tener tipo. Si no hay ningun gasto con monto, devolve la lista gastos vacia. Ejemplo: entrada 400 de nafta y 500 de agua para fletes; salida dos gastos: Nafta con monto 400 y tipo vacio, y Agua con monto 500 y tipo fletes. Responde unicamente con el JSON.' }, { role: 'user', content: $('Unificar Texto').item.json.texto } ] }) }}",
        "options": {}
      },
      "id": "parsear-gastos-gpt",
      "name": "Parsear Gastos GPT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2320,
        160
      ],
      "credentials": {
        "openAiApi": {
          "id": "19LKpht4lAMl7Sed",
          "name": "OpenAI account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const entrada = $('Unificar Texto').item.json;\nconst numeroOrigen = entrada.numero_origen;\nconst audioId = entrada.audio_id;\nconst transcripcion = entrada.texto ?? '';\n\nlet contenido = $json.choices?.[0]?.message?.content ?? '';\nlet parsed = {};\ntry { parsed = JSON.parse(contenido); } catch (e) { parsed = {}; }\nlet gastos = Array.isArray(parsed) ? parsed : (parsed.gastos ?? []);\n\nlet motivoReintento = '';\nif (!String(transcripcion).trim()) {\n  motivoReintento = entrada.is_audio\n    ? 'No pude transcribir el audio. Reenvia un audio de voz claro.'\n    : 'Mandame el gasto con su monto, por audio o por texto. Ejemplo: nafta 20000.';\n}\n\ngastos = (Array.isArray(gastos) ? gastos : [])\n  .map((item) => ({\n    descripcion: String(item.descripcion ?? '').trim(),\n    monto: Number(String(item.monto ?? '').replace(',', '.')),\n    tipo: String(item.tipo ?? '').trim()\n  }))\n  .filter((item) => item.descripcion && Number.isFinite(item.monto) && item.monto > 0);\n\nif (!gastos.length && !motivoReintento) {\n  motivoReintento = 'No pude extraer gastos con monto. Manda cada gasto con su importe, por ejemplo: nafta 20000, peaje 1500.';\n}\n\nreturn { json: { numero_origen: numeroOrigen, audio_id: audioId, transcripcion: transcripcion, gastos: gastos, motivo_reintento: motivoReintento } };"
      },
